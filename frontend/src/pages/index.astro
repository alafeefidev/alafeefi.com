---
import '../styles/global.css'
---

<html lang="en" class="scrollbar-none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />

		<title>Hamad Alafeefi | Cybersecurity Student & Software Engineer</title>
        <meta name="description" content="Hamad Alafeefi (حمد العفيفي) - IT and Cybersecurity student at Abu Dhabi University. I like building stuff and explore how they work. Interested in AppSec, and write about what I find interesting. Mostly Python, Go, and TypeScript." />
        <meta name="keywords" content="Hamad Alafeefi, حمد العفيفي, cybersecurity, Abu Dhabi University, appsec, software engineer, UAE, Python, Go, TypeScript" />
		<meta name="author" content="Hamad Alafeefi" />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#17171c" />

		<link rel="canonical" href="https://alafeefi.com" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		
        <meta property="og:title" content="Hamad Alafeefi | حمد العفيفي" />
        <meta property="og:description" content="IT and Cybersecurity student at Abu Dhabi University. I like building stuff and explore how they work. Interested in AppSec, and write about what I find interesting. Mostly Python, Go, and TypeScript." />
        <meta property="og:url" content="https://alafeefi.com" />
        <meta property="og:type" content="website" />
		<meta property="og:image" content="https://alafeefi.com/og-image.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Hamad Alafeefi - IT & Cybersecurity Student" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Hamad Alafeefi | حمد العفيفي" />
		<meta name="twitter:description" content="IT and Cybersecurity student at Abu Dhabi University. I like building stuff and explore how they work. Interested in AppSec, and write about what I find interesting." />
		<meta name="twitter:image" content="https://alafeefi.com/og-image.png" />

		<script is:inline type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Person",
				"name": "Hamad Alafeefi",
				"alternateName": "حمد العفيفي",
				"url": "https://alafeefi.com",
				"sameAs": [
				"https://github.com/alafeefidev",
				"https://linkedin.com/in/alafeefi/"
				],
				"jobTitle": "IT & Cybersecurity Student",
				"memberOf": {
					"@type": "Organization",
					"name": "Abu Dhabi University"
				}
			}
		</script>
	</head>
    <body class="bg-[#17171c] h-screen flex justify-center items-center cursor-mo-default selection:text-red-200 selection:bg-red-200/30">
        <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
            <div class="absolute w-72 h-72 sm:w-130 sm:h-130 bg-[#E3170A] rounded-full top-10 sm:top-20 left-20 sm:left-40 opacity-40 blur-2xl animate-float-medium"></div>
            <div class="absolute w-72 h-72 sm:w-130 sm:h-130 bg-[#A9E5BB] rounded-full bottom-10 sm:bottom-20 right-20 sm:right-40 opacity-40 blur-2xl animate-float-medium"></div>
        </div>

        <div id="card" class="bg-white/3 w-9/10 sm:w-1/2 lg:w-1/3 max-h-fit min-h-2/10 md:min-h-0 md:max-h-fit rounded-3xl backdrop-blur-xl shadow-lg ring-1 ring-white/12 p-2 pt-3 flex flex-col justify-between">
            <h1 class="text-white/50 text-center font-outfit font-bold text-6xl">Hamad</h1>
            <p class="text-white/60 font-outfit pt-1 md:py-2 px-2  sm:mb-0 md:mb-0 sm:text-center sm:text-xl">
				My name is Hamad Alafeefi <span class="font-sans">(حمد العفيفي)</span>,
				an IT & Cybersecurity student at Abu Dhabi University. I enjoy building software and dive into the security side of things, mostly use Python, Go, and TypeScript.
			</p>
			<div class="flex justify-between gap-2 md:gap-3 px-1 h-15 md:h-17 pb-3">
				<a href="https://github.com/alafeefidev" aria-label="Hamad Alafeefi on GitHub" class="h-full mt-3 w-full cursor-mo-hand bg-white/7 text-white/50 backdrop-blur-4xl shadow-lg ring-1 ring-white/15 select-none rounded-full flex justify-center items-center font-outfit font-bold text-xl sm:text-3xl z-5 transition-all duration-350 hover:opacity-95 hover:bg-black/10" rel="noopener noreferrer" target="_blank">
					<span>GitHub</span>
				</a>
				<a href="https://linkedin.com/in/alafeefi/" aria-label="Hamad Alafeefi on LinkedIn" class="h-full mt-3 w-full cursor-mo-hand bg-rose-500 text-white/80 backdrop-blur-4xl shadow-lg ring-1 ring-white/15 select-none rounded-full flex justify-center items-center font-outfit font-bold text-xl sm:text-3xl z-5 transition-all duration-350 hover:opacity-95 hover:bg-rose-600/10" rel="noopener noreferrer" target="_blank">
					<span>LinkedIn</span>
				</a>
			</div>

            <div id="task-buttons" aria-hidden="true" class="absolute px-2 bg-white/6 backdrop-blur-xl select-none shadow-sm ring-1 ring-white/15 top-0 right-0 w-15 h-6 m-3 rounded-4xl justify-between items-center hidden sm:flex">
                <div id="red-circle" class="w-3 h-3 cursor-mo-hand transition-opacity duration-200 hover:opacity-80 bg-red-500 rounded-full bg-red"></div>
                <div id="yellow-circle" class="w-3 h-3 cursor-mo-hand transition-opacity duration-200 hover:opacity-80 bg-yellow-400 rounded-full bg-red"></div>
                <div id="green-circle" class="w-3 h-3 cursor-mo-hand transition-opacity duration-200 hover:opacity-80 bg-green-500 rounded-full bg-red"></div>
            </div>
        </div>
    </body>
</html>
